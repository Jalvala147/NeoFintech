@model IEnumerable<ProyectoIndursa.Models.CuentaListaItem>
@{
    ViewBag.Title = "Cuentas";
}

<partial name="_NavEmployee" />
<div class="nf-page">
    <div class="nf-shell">
        <p class="nf-kicker">Clientes</p>
        <h1 class="nf-title mb-3">Solicitudes de cuenta</h1>
        <partial name="_Alerts" />
        <div class="nf-table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Cuenta</th>
                        <th>Nombre</th>
                        <th>Apellidos</th>
                        <th>CURP</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NoCuenta</td>
                            <td>@item.Nombre</td>
                            <td>@item.ApellidoPaterno @item.ApellidoMaterno</td>
                            <td>@item.Curp</td>
                            <td>
                                <span class="nf-badge @(item.TipoCuenta switch { 1 => "nf-badge--warn", 2 => "nf-badge--ok", 3 => "nf-badge--danger", _ => "nf-badge--muted" })">
                                    @item.EstadoTexto
                                </span>
                                @if (!string.IsNullOrEmpty(item.MotivoRechazo))
                                {
                                    <div class="small text-muted mt-1">@item.MotivoRechazo</div>
                                }
                            </td>
                            <td>
                                @if (item.TipoCuenta == 1)
                                {
                                    <div class="nf-inline-actions">
                                        <form asp-action="AcceptAccount" method="post">
                                            <input type="hidden" name="noCuenta" value="@item.NoCuenta" />
                                            <button type="submit" class="btn btn-success btn-sm">Aceptar</button>
                                        </form>
                                        <form asp-action="RejectAccount" method="post" class="d-flex gap-1 flex-wrap">
                                            <input type="hidden" name="noCuenta" value="@item.NoCuenta" />
                                            <input name="motivo" class="form-control form-control-sm" placeholder="Motivo" required />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Rechazar</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
