@model IEnumerable<ProyectoIndursa.Models.CuentaListaItem>
@{
    ViewBag.Title = "Cuentas";
}

<partial name="_NavEmployee" />
<div class="container pb-5">
    <h1 class="h3 mb-3">Solicitudes de cuenta</h1>
    <partial name="_Alerts" />
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Número de cuenta</th>
                <th>Nombre(s)</th>
                <th>Apellido paterno</th>
                <th>Apellido materno</th>
                <th>CURP</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NoCuenta</td>
                    <td>@item.Nombre</td>
                    <td>@item.ApellidoPaterno</td>
                    <td>@item.ApellidoMaterno</td>
                    <td>@item.Curp</td>
                    <td>
                        @item.EstadoTexto
                        @if (!string.IsNullOrEmpty(item.MotivoRechazo))
                        {
                            <div class="small text-muted">@item.MotivoRechazo</div>
                        }
                    </td>
                    <td>
                        @if (item.TipoCuenta == 1)
                        {
                            <form asp-action="AcceptAccount" method="post" class="d-inline">
                                <input type="hidden" name="noCuenta" value="@item.NoCuenta" />
                                <button type="submit" class="btn btn-success btn-sm">Aceptar</button>
                            </form>
                            <form asp-action="RejectAccount" method="post" class="d-inline-block mt-1">
                                <input type="hidden" name="noCuenta" value="@item.NoCuenta" />
                                <input name="motivo" class="form-control form-control-sm d-inline-block" style="width: 160px;" placeholder="Motivo" required />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Rechazar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
