@model IEnumerable<ProyectoIndursa.Models.PrestamoListaItem>
@{
    ViewBag.Title = "Préstamos";
}

<partial name="_NavEmployee" />
<div class="container pb-5">
    <h1 class="h3 mb-3">Solicitudes de préstamo</h1>
    <partial name="_Alerts" />
    @if (!Model.Any())
    {
        <p class="text-secondary">No hay préstamos registrados.</p>
    }
    else
    {
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Cuenta</th>
                    <th>Solicitante</th>
                    <th>Cantidad</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Folio</td>
                        <td>@item.SolicitadoPor</td>
                        <td>@item.Solicitante</td>
                        <td>$@item.Cantidad.ToString("N2")</td>
                        <td>@(item.FechaExpedicion == default ? "N/D" : item.FechaExpedicion.ToString("dd/MM/yyyy"))</td>
                        <td>
                            @item.EstadoTexto
                            @if (!string.IsNullOrEmpty(item.MotivoRechazo))
                            {
                                <div class="small text-muted">@item.MotivoRechazo</div>
                            }
                        </td>
                        <td>
                            @if (item.Estado == 0)
                            {
                                <form asp-action="AcceptPrestamo" method="post" class="d-inline">
                                    <input type="hidden" name="folio" value="@item.Folio" />
                                    <button type="submit" class="btn btn-success btn-sm">Aprobar</button>
                                </form>
                                <form asp-action="RejectPrestamo" method="post" class="d-inline-block mt-1">
                                    <input type="hidden" name="folio" value="@item.Folio" />
                                    <input name="motivo" class="form-control form-control-sm d-inline-block" style="width: 160px;" placeholder="Motivo" required />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Rechazar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
