@{
    ViewBag.Title = "Empleado";
}

<partial name="_NavEmployee" />
<div class="nf-page">
    <div class="nf-shell">
        <p class="nf-kicker">Operaciones</p>
        <h1 class="nf-title mb-4">Panel de empleado</h1>
        <div class="nf-grid nf-grid-3">
            <div class="nf-stat">
                <div class="label">Cuentas pendientes</div>
                <p class="value">@ViewBag.PendientesCuentas</p>
                <a class="btn btn-primary btn-sm mt-3" asp-action="Cuentas">Revisar</a>
            </div>
            <div class="nf-stat">
                <div class="label">Préstamos pendientes</div>
                <p class="value">@ViewBag.PendientesPrestamos</p>
                <a class="btn btn-primary btn-sm mt-3" asp-action="Prestamos">Revisar</a>
            </div>
            <div class="nf-stat">
                <div class="label">Boletos de rifa</div>
                <p class="value">@ViewBag.BoletosRifa</p>
                <a class="btn btn-primary btn-sm mt-3" asp-action="Rifa">Sortear</a>
            </div>
        </div>
    </div>
</div>
