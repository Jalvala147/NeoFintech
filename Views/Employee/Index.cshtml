@{
    ViewBag.Title = "Empleado";
}

<partial name="_NavEmployee" />
<div class="container pb-5">
    <h1 class="h3 mb-3">Panel de empleado</h1>
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5">Cuentas pendientes</h2>
                    <p class="display-6">@ViewBag.PendientesCuentas</p>
                    <a class="btn btn-primary" asp-action="Cuentas">Revisar cuentas</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5">Préstamos pendientes</h2>
                    <p class="display-6">@ViewBag.PendientesPrestamos</p>
                    <a class="btn btn-primary" asp-action="Prestamos">Revisar préstamos</a>
                </div>
            </div>
        </div>
    </div>
</div>
