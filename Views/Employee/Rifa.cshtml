@model IEnumerable<ProyectoIndursa.Models.Rifa>
@{
    ViewBag.Title = "Rifa";
}

<partial name="_NavEmployee" />
<div class="container pb-5">
    <h1 class="h3 mb-3">Rifa</h1>
    <partial name="_Alerts" />
    <p>Boletos participantes: <strong>@ViewBag.Participantes</strong>. El premio es $1,000.</p>
    <form asp-action="SortearRifa" method="post" class="mb-3">
        <button type="submit" class="btn btn-primary">Sortear ganador</button>
    </form>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Boleto</th>
                <th>Cuenta</th>
                <th>Fecha</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NoBoleto</td>
                    <td>@item.Cuenta</td>
                    <td>@item.FechaBoleto.ToString("dd/MM/yyyy")</td>
                    <td>@(item.Ganador == 1 ? "Ganador" : "Participante")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
