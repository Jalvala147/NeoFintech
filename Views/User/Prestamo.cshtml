@model IEnumerable<ProyectoIndursa.Models.PrestamoListaItem>
@{
    ViewBag.Title = "Préstamos";
}

<partial name="_NavUser" />
<div class="container pb-5">
    <h1 class="h3 mb-3">Préstamos</h1>
    <p>Saldo actual: <strong>$@(((decimal)ViewBag.Saldo).ToString("N2"))</strong></p>

    @if (TempData["Ok"] is string ok)
    {
        <div class="alert alert-success">@ok</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }
    @if (ViewBag.Mensaje is string mensaje)
    {
        <div class="alert alert-warning">@mensaje</div>
    }

    @if (ViewBag.PuedeSolicitar == true)
    {
        <a class="btn btn-primary mb-3" asp-action="SolicitarPrestamo">Solicitar préstamo</a>
    }

    @if (Model.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Cantidad</th>
                    <th>Pagos realizados</th>
                    <th>Pagos pendientes</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Folio</td>
                        <td>$@item.Cantidad.ToString("N2")</td>
                        <td>@item.PagoRealizados</td>
                        <td>@item.PagoPedientes</td>
                        <td>@item.EstadoTexto</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
