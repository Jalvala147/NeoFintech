@model IEnumerable<ProyectoIndursa.Models.Movimiento>
@{
    ViewBag.Title = "Movimientos";
}

<partial name="_NavUser" />
<div class="nf-page">
    <div class="nf-shell">
        <p class="nf-kicker">Historial</p>
        <h1 class="nf-title mb-3">Movimientos</h1>
        @if (!Model.Any())
        {
            <div class="nf-panel nf-empty">Aún no hay movimientos.</div>
        }
        else
        {
            <div class="nf-table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Folio</th>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Concepto</th>
                            <th>Monto</th>
                            <th>Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="nf-badge nf-badge--info">@item.Tipo</span></td>
                                <td>@item.Concepto</td>
                                <td>$@item.Monto.ToString("N2")</td>
                                <td>$@item.SaldoResultante.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
