@model IEnumerable<ProyectoIndursa.Models.Movimiento>
@{
    ViewBag.Title = "Movimientos";
}

<partial name="_NavUser" />
<div class="container pb-5">
    <h1 class="h3 mb-3">Historial de movimientos</h1>
    @if (!Model.Any())
    {
        <p class="text-secondary">Aún no hay movimientos.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Concepto</th>
                    <th>Monto</th>
                    <th>Saldo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Tipo</td>
                        <td>@item.Concepto</td>
                        <td>$@item.Monto.ToString("N2")</td>
                        <td>$@item.SaldoResultante.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
