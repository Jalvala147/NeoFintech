@model ProyectoIndursa.Models.ComprobanteViewModel
@{
    ViewBag.Title = "Comprobante";
}

<partial name="_NavUser" />
<div class="container pb-5" style="max-width: 560px;">
    <h1 class="h3 mb-3">Comprobante</h1>
    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-5">Folio</dt>
                <dd class="col-sm-7">@Model.Folio</dd>
                <dt class="col-sm-5">Cuenta</dt>
                <dd class="col-sm-7">@Model.NoCuenta</dd>
                <dt class="col-sm-5">Tipo</dt>
                <dd class="col-sm-7">@Model.Tipo</dd>
                <dt class="col-sm-5">Concepto</dt>
                <dd class="col-sm-7">@Model.Concepto</dd>
                <dt class="col-sm-5">Monto</dt>
                <dd class="col-sm-7">$@Model.Monto.ToString("N2")</dd>
                <dt class="col-sm-5">Saldo resultante</dt>
                <dd class="col-sm-7">$@Model.SaldoResultante.ToString("N2")</dd>
                <dt class="col-sm-5">Referencia</dt>
                <dd class="col-sm-7">@(Model.Referencia ?? "—")</dd>
                <dt class="col-sm-5">Fecha</dt>
                <dd class="col-sm-7">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
            </dl>
        </div>
    </div>
    <a class="btn btn-primary mt-3" asp-action="Movimientos">Ver movimientos</a>
    <a class="btn btn-outline-secondary mt-3" asp-action="Index">Inicio</a>
</div>
