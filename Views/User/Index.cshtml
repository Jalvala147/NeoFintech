@{
    ViewBag.Title = "Inicio";
}

<partial name="_NavUser" />
<div class="container pb-5">
    <h1 class="h3">Hola, @ViewBag.Nombre</h1>
    <p class="text-secondary">Cuenta @ViewBag.NoCuenta</p>
    <div class="row g-3">
        <div class="col-md-4">
            <a class="btn btn-outline-primary w-100" asp-action="Saldo">Ver saldo</a>
        </div>
        <div class="col-md-4">
            <a class="btn btn-outline-primary w-100" asp-action="Prestamo">Préstamos</a>
        </div>
        <div class="col-md-4">
            <a class="btn btn-outline-primary w-100" asp-action="Perfil">Perfil</a>
        </div>
    </div>
</div>
