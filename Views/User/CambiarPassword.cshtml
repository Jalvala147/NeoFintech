@model ProyectoIndursa.Models.CambiarPasswordViewModel
@{
    ViewBag.Title = "Cambiar contraseña";
}

<partial name="_NavUser" />
<div class="nf-page">
    <div class="nf-shell">
        <div class="nf-panel nf-panel--narrow">
            <p class="nf-kicker">Seguridad</p>
            <h1 class="nf-title">Cambiar contraseña</h1>
            <form asp-action="CambiarPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Actual" class="form-label"></label>
                    <input asp-for="Actual" class="form-control" />
                    <span asp-validation-for="Actual" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Nueva" class="form-label"></label>
                    <input asp-for="Nueva" class="form-control" />
                    <span asp-validation-for="Nueva" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Confirmacion" class="form-label"></label>
                    <input asp-for="Confirmacion" class="form-control" />
                    <span asp-validation-for="Confirmacion" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Actualizar</button>
            </form>
        </div>
    </div>
</div>
