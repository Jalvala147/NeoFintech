@model IEnumerable<ProyectoIndursa.Models.PrestamoListaItem>
@{
    ViewBag.Title = "Historial";
}

<partial name="_NavUser" />
<div class="container pb-5">
    <h1 class="h3 mb-3">Historial de préstamos</h1>
    @if (!Model.Any())
    {
        <p class="text-secondary">Aún no tienes préstamos.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Cantidad</th>
                    <th>Fecha de expedición</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Folio</td>
                        <td>$@item.Cantidad.ToString("N2")</td>
                        <td>@item.FechaExpedicion.ToString("dd/MM/yyyy")</td>
                        <td>@item.EstadoTexto</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
