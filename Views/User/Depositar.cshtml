@model ProyectoIndursa.Models.OperacionMontoViewModel
@{
    ViewBag.Title = "Depositar";
}

<partial name="_NavUser" />
<div class="container pb-5" style="max-width: 480px;">
    <h1 class="h3 mb-3">Depositar</h1>
    <p class="text-secondary">Un depósito de $500 o más te da un boleto de rifa.</p>
    <form asp-action="Depositar" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Monto" class="form-label"></label>
            <input asp-for="Monto" class="form-control" type="number" min="1" step="0.01" />
            <span asp-validation-for="Monto" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Depositar</button>
    </form>
</div>
