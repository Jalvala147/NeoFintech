@model ErrorViewModel
@{
    ViewBag.Title = "Error";
}

<partial name="_NavPublic" />
<div class="nf-page">
    <div class="nf-shell">
        <div class="nf-panel nf-panel--narrow">
            <h1 class="nf-title text-danger">Ocurrió un error</h1>
            <p class="nf-lead">No se pudo completar la solicitud. Vuelve a intentar o inicia sesión de nuevo.</p>
            @if (Model.ShowRequestId)
            {
                <p class="nf-meta">Solicitud: <code>@Model.RequestId</code></p>
            }
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ir al inicio</a>
        </div>
    </div>
</div>
