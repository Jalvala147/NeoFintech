@{
    ViewBag.Title = "Registro completado";
}

<partial name="_NavPublic" />
<div class="container py-5" style="max-width: 560px;">
    <h1 class="h3 text-primary">Registro completado</h1>
    <p>Tu solicitud fue enviada. Guarda tu número de cuenta; lo necesitarás para iniciar sesión cuando un empleado la apruebe.</p>
    <p class="fs-4">Número de cuenta: <strong>@ViewBag.NoCuenta</strong></p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Login">Ir a iniciar sesión</a>
</div>
