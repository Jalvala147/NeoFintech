@{
    ViewBag.Title = "NeoFintech";
    ViewBag.HeroNav = true;
}

<partial name="_NavPublic" />
<section class="nf-hero">
    <div class="nf-hero-pattern" aria-hidden="true"></div>
    <div class="nf-hero-orb" aria-hidden="true"></div>
    <div class="nf-hero-inner">
        <p class="nf-kicker nf-reveal" style="color: #d7f3ef;">Banca digital</p>
        <h1 class="nf-hero-brand nf-reveal nf-reveal-delay-1">NeoFintech</h1>
        <p class="nf-hero-copy nf-reveal nf-reveal-delay-2">
            Mueve tu dinero, solicita crédito y sigue cada movimiento con claridad.
        </p>
        <div class="nf-hero-cta nf-reveal nf-reveal-delay-3">
            <a class="btn btn-primary btn-lg" asp-controller="Home" asp-action="Login">Iniciar sesión</a>
            <a class="btn btn-outline-primary btn-lg" asp-controller="Home" asp-action="Register">Solicitar cuenta</a>
        </div>
    </div>
</section>

<section class="nf-section">
    <div class="nf-shell">
        <p class="nf-kicker">Qué puedes hacer</p>
        <h2>Una cuenta clara para el día a día</h2>
        <div class="nf-feature-list">
            <article class="nf-feature">
                <h3>Tu dinero</h3>
                <p>Consulta saldo, deposita, retira y transfiere entre cuentas con comprobante.</p>
            </article>
            <article class="nf-feature">
                <h3>Préstamos</h3>
                <p>Solicita, espera aprobación, paga mensualidades y revisa la amortización.</p>
            </article>
            <article class="nf-feature">
                <h3>Operación</h3>
                <p>Empleados aprueban solicitudes y gerencia administra el equipo.</p>
            </article>
        </div>
    </div>
</section>
