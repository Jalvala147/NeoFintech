@model ProyectoIndursa.Models.RegisterViewModel
@{
    ViewBag.Title = "Solicitar cuenta";
}

<partial name="_NavPublic" />
<div class="nf-page nf-page--auth">
    <div class="nf-shell">
        <div class="nf-panel nf-panel--mid nf-reveal">
            <p class="nf-kicker">Alta</p>
            <h1 class="nf-title">Solicitar cuenta</h1>
            <p class="nf-lead">Completa tus datos. Un empleado revisará y aprobará tu solicitud.</p>
            <form asp-controller="Home" asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="nf-grid nf-grid-2">
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Curp" class="form-label"></label>
                        <input asp-for="Curp" class="form-control" maxlength="18" />
                        <span asp-validation-for="Curp" class="text-danger"></span>
                    </div>
                </div>
                <div class="nf-grid nf-grid-2">
                    <div class="mb-3">
                        <label asp-for="ApellidoPaterno" class="form-label"></label>
                        <input asp-for="ApellidoPaterno" class="form-control" />
                        <span asp-validation-for="ApellidoPaterno" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ApellidoMaterno" class="form-label"></label>
                        <input asp-for="ApellidoMaterno" class="form-control" />
                        <span asp-validation-for="ApellidoMaterno" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="FechaDeNacimiento" class="form-label"></label>
                    <input asp-for="FechaDeNacimiento" class="form-control" type="date" />
                    <span asp-validation-for="FechaDeNacimiento" class="text-danger"></span>
                </div>
                <div class="nf-grid nf-grid-2">
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100">Enviar solicitud</button>
            </form>
        </div>
    </div>
</div>
