@model ProyectoIndursa.Models.LoginViewModel
@{
    ViewBag.Title = "Iniciar sesión";
}

<partial name="_NavPublic" />
<div class="container py-5" style="max-width: 480px;">
    <h1 class="h3 fw-bold text-primary mb-3">Iniciar sesión</h1>
    <p class="text-secondary">Accede a tu cuenta de forma segura.</p>
    <partial name="_Alerts" />

    <form asp-controller="Home" asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="NoCuenta" class="form-label"></label>
            <input asp-for="NoCuenta" class="form-control" placeholder="Número de cuenta" />
            <span asp-validation-for="NoCuenta" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" placeholder="Contraseña" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Iniciar sesión</button>
    </form>
    <p class="mt-3"><a asp-controller="Home" asp-action="Recuperar">¿Olvidaste tu contraseña?</a></p>
</div>
