@model ProyectoIndursa.Models.RecuperarPasswordViewModel
@{
    ViewBag.Title = "Recuperar contraseña";
}

<partial name="_NavPublic" />
<div class="nf-page nf-page--auth">
    <div class="nf-shell">
        <div class="nf-panel nf-panel--narrow nf-reveal">
            <p class="nf-kicker">Seguridad</p>
            <h1 class="nf-title">Recuperar contraseña</h1>
            <p class="nf-lead">Confirma tu cuenta, CURP y fecha de nacimiento.</p>
            <form asp-action="Recuperar" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="NoCuenta" class="form-label"></label>
                    <input asp-for="NoCuenta" class="form-control" />
                    <span asp-validation-for="NoCuenta" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Curp" class="form-label"></label>
                    <input asp-for="Curp" class="form-control" />
                    <span asp-validation-for="Curp" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FechaDeNacimiento" class="form-label"></label>
                    <input asp-for="FechaDeNacimiento" class="form-control" type="date" />
                    <span asp-validation-for="FechaDeNacimiento" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Nueva" class="form-label"></label>
                    <input asp-for="Nueva" class="form-control" />
                    <span asp-validation-for="Nueva" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Confirmacion" class="form-label"></label>
                    <input asp-for="Confirmacion" class="form-control" />
                    <span asp-validation-for="Confirmacion" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Restablecer</button>
            </form>
        </div>
    </div>
</div>
